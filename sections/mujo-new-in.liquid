{%- comment -%}
  MUJŌ CO. — New In product carousel
  Duplicated from mujo-best-sellers.liquid — identical design, layout,
  card styling, interactions, and responsive behavior. Fully independent:
  its own CSS scope (mujo-new-in-{{ section.id }}), its own schema, own
  settings/blocks. Does not modify or depend on the Best Sellers section
  in any way — both can be added to the homepage and edited separately
  without conflicting.

  Manually curate up to 8 products via blocks in the Theme Editor.
  Falls back to the store's general product list only if no products are selected.
{%- endcomment -%}

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<script>
  if (!customElements.get('mujo-product-card')) {
    class MujoProductCard extends HTMLElement {
      connectedCallback() {
        // Delegate from the custom element itself, and look up
        // children lazily inside the handler (not here). During
        // initial HTML parsing this element can be upgraded the
        // instant its opening tag is seen, before its own children
        // (swatches, image, price) have been parsed yet — querying
        // for them here would silently find nothing.
        this.addEventListener('click', (event) => {
          const swatch = event.target.closest('.mujo-pc-swatch');
          if (swatch && this.contains(swatch)) {
            this.selectSwatch(swatch);
          }
        });

        // The secondary hover image is shown via CSS :hover, which
        // stays active while the mouse is over a swatch (since the
        // swatch is inside the card). Without this, a swatch click
        // would update the primary image's src correctly but it'd
        // stay invisible (opacity: 0 from the hover rule) until the
        // mouse actually left and re-entered the card. Clearing the
        // inline override on mouseleave hands control back to the
        // normal CSS hover behavior for the next hover.
        this.addEventListener('mouseleave', () => {
          this.clearImageOverride();
        });
      }

      clearImageOverride() {
        const primary = this.querySelector('.mujo-pc-image-primary');
        const secondary = this.querySelector('.mujo-pc-image-secondary');
        if (primary) primary.style.opacity = '';
        if (secondary) secondary.style.opacity = '';
      }

      selectSwatch(swatch) {
        const swatches = this.querySelectorAll('.mujo-pc-swatch');
        const image = this.querySelector('.mujo-pc-image-primary');
        const secondaryImage = this.querySelector('.mujo-pc-image-secondary');
        const priceEl = this.querySelector('.mujo-pc-price');
        const variantInput = this.querySelector('.mujo-pc-variant-id');
        const addButton = this.querySelector('.mujo-pc-add-to-bag');

        swatches.forEach((s) => {
          const isSelected = s === swatch;
          s.classList.toggle('is-selected', isSelected);
          s.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        });

        const available = swatch.dataset.available === 'true';
        const colorLabel = swatch.getAttribute('aria-label') || '';

        if (image && swatch.dataset.image) {
          image.src = swatch.dataset.image;
          if (swatch.dataset.imageSrcset) {
            image.srcset = swatch.dataset.imageSrcset;
          }
          // Force the just-updated image visible right now, overriding
          // whatever the CSS :hover rule currently has it set to.
          image.style.opacity = '1';
          if (secondaryImage) secondaryImage.style.opacity = '0';
        }

        if (variantInput) {
          variantInput.value = swatch.dataset.variantId;
        }

        if (addButton) {
          addButton.disabled = !available;
          const baseLabel = available ? 'Add to Bag' : 'Sold out';
          addButton.setAttribute('aria-label', baseLabel + (colorLabel ? ' — ' + colorLabel : ''));
        }

        if (priceEl) {
          const price = swatch.dataset.price;
          const comparePrice = swatch.dataset.comparePrice;
          if (comparePrice) {
            priceEl.innerHTML =
              '<span class="mujo-pc-price-sale">' + price + '</span> ' +
              '<s class="mujo-pc-price-compare">' + comparePrice + '</s>';
          } else {
            priceEl.innerHTML = '<span class="mujo-pc-price-regular">' + price + '</span>';
          }
        }
      }
    }
    customElements.define('mujo-product-card', MujoProductCard);
  }
</script>

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Urbanist:wght@400;500;600&display=swap');

  .mujo-new-in-{{ section.id }} {
    background: #FAFAF7;
    padding: 32px 0;
  }

  .mujo-new-in-{{ section.id }} .mujo-bs-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .mujo-new-in-{{ section.id }} .mujo-bs-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .mujo-new-in-{{ section.id }} .mujo-bs-heading {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 3vw, 40px);
    color: #1B1A18;
    margin: 0;
  }

  .mujo-new-in-{{ section.id }} .mujo-bs-shopall {
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1B1A18;
    text-decoration: none;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .mujo-new-in-{{ section.id }} .mujo-bs-shopall:hover {
    border-color: #1B1A18;
  }

  .mujo-new-in-{{ section.id }} slider-component {
    display: block;
  }

  .mujo-new-in-{{ section.id }} .mujo-bs-track {
    display: flex;
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0 48px 8px;
  }

  .mujo-new-in-{{ section.id }} .mujo-bs-track.slider {
    overflow-x: auto;
    scroll-padding-left: 48px;
    scroll-padding-right: 48px;
  }

  .mujo-new-in-{{ section.id }} .mujo-bs-slide {
    flex: 0 0 auto;
    width: calc((100% - (2 * 14px)) / 3);
    scroll-snap-align: start;
  }

  @media screen and (max-width: 989px) {
    .mujo-new-in-{{ section.id }} .mujo-bs-slide {
      width: calc((100% - 14px) / 2.1);
    }
  }

  @media screen and (max-width: 749px) {
    .mujo-new-in-{{ section.id }} {
      padding: 24px 0;
    }
    .mujo-new-in-{{ section.id }} .mujo-bs-inner {
      padding: 0 24px;
    }
    .mujo-new-in-{{ section.id }} .mujo-bs-header {
      margin-bottom: 20px;
    }
    .mujo-new-in-{{ section.id }} .mujo-bs-slide {
      width: 62%;
    }
    .mujo-new-in-{{ section.id }} .mujo-bs-track {
      gap: 12px;
      padding: 0 20px 8px;
    }
    .mujo-new-in-{{ section.id }} .mujo-bs-track.slider {
      scroll-padding-left: 20px;
      scroll-padding-right: 20px;
    }
  }

  /* Unified editorial product card: image and info are one
     continuous block, no gap/border/shadow between them. */
  .mujo-new-in-{{ section.id }} .mujo-pc {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .mujo-new-in-{{ section.id }} .mujo-pc-media {
    position: relative;
    overflow: hidden;
    background-color: #E5E2D9;
    aspect-ratio: 4 / 5;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.4s ease;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-image-secondary {
    opacity: 0;
  }

  .mujo-new-in-{{ section.id }} .mujo-pc-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(250, 250, 247, 0.96) 0%,
      rgba(250, 250, 247, 0.82) 30%,
      rgba(250, 250, 247, 0) 62%
    );
    pointer-events: none;
  }

  .mujo-new-in-{{ section.id }} .mujo-pc-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: #C9A7E8;
    color: #1B1A18;
    font-family: 'Urbanist', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 2px;
  }

  .mujo-new-in-{{ section.id }} .mujo-pc-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 16px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-title {
    font-family: 'Urbanist', sans-serif;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.01em;
    color: #1B1A18;
    text-decoration: none;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-subtitle {
    font-family: 'Urbanist', sans-serif;
    font-size: 12px;
    color: #6B6862;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-price {
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #1B1A18;
    margin-top: 2px;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-price-sale {
    color: #1B1A18;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-price-compare {
    color: #8A8579;
    margin-left: 4px;
  }

  .mujo-new-in-{{ section.id }} .mujo-pc-swatches {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-swatch {
    width: 16px;
    height: 16px;
    padding: 0;
    border-radius: 50%;
    position: relative;
    border: 1.5px solid rgba(27, 26, 24, 0.25);
    background-color: #E5E2D9;
    cursor: pointer;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-swatch.is-selected::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1.5px solid #1B1A18;
    border-radius: 50%;
  }

  /* Add to Bag: small icon button anchored top-right of the image.
     Revealed on hover on desktop; always visible on touch devices. */
  .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag-wrap {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    margin: 0;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-form {
    margin: 0;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    background: transparent;
    border: none;
    cursor: pointer;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag:hover {
    transform: translateY(0) scale(1.08);
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag:disabled {
    opacity: 0.35 !important;
    cursor: default;
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag-icon {
    display: flex;
    filter: drop-shadow(0 1px 3px rgba(0, 0, 0, 0.45));
  }
  .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag .loading__spinner {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .mujo-new-in-{{ section.id }} .mujo-pc:hover .mujo-pc-add-to-bag {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (hover: none) {
    .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag {
      opacity: 1;
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .mujo-new-in-{{ section.id }} .mujo-pc:hover .mujo-pc-image-primary {
      opacity: 0;
    }
    .mujo-new-in-{{ section.id }} .mujo-pc:hover .mujo-pc-image-secondary {
      opacity: 1;
    }
  }

  .mujo-new-in-{{ section.id }} .slider-buttons {
    justify-content: flex-end;
    margin-top: 16px;
  }

  @media screen and (max-width: 749px) {
    .mujo-new-in-{{ section.id }} .mujo-pc-badge {
      font-size: 9px;
      padding: 4px 8px;
    }
    .mujo-new-in-{{ section.id }} .mujo-pc-title {
      font-size: 13px;
    }
    .mujo-new-in-{{ section.id }} .mujo-pc-subtitle {
      font-size: 11px;
    }
    .mujo-new-in-{{ section.id }} .mujo-pc-price {
      font-size: 12px;
    }
    .mujo-new-in-{{ section.id }} .mujo-pc-swatch {
      width: 14px;
      height: 14px;
    }
    .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag {
      width: 48px;
      height: 48px;
    }
    .mujo-new-in-{{ section.id }} .mujo-pc-add-to-bag-icon svg {
      width: 20px;
      height: 20px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign product_count = section.blocks.size

  if product_count == 0 and section.settings.collection != blank
    assign product_count = section.settings.collection.products.size | at_most: 8
  endif

  if product_count == 0
    assign product_count = collections.all.products.size | at_most: 8
  endif

  assign show_slider = false
  if product_count > 4
    assign show_slider = true
  endif
-%}

<div class="mujo-new-in-{{ section.id }}">
  <div class="mujo-bs-inner">
    <div class="mujo-bs-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="mujo-bs-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.shop_all_link != blank -%}
        <a href="{{ section.settings.shop_all_link }}" class="mujo-bs-shopall">
          {{ section.settings.shop_all_label | default: 'Shop All' }}
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    {%- if product_count > 0 -%}
      <slider-component>
        <ul
          id="Slider-{{ section.id }}"
          class="mujo-bs-track{% if show_slider %} slider slider--mobile slider--tablet{% endif %}"
          role="list"
          aria-label="{{ 'general.slider.name' | t }}"
        >
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks limit: 8 -%}
              {%- assign product = block.settings.product -%}
              {%- assign lazy_load = false -%}
              {%- if forloop.index > 2 -%}
                {%- assign lazy_load = true -%}
              {%- endif -%}
              {%- if product != blank -%}
                <li
                  id="Slide-{{ section.id }}-{{ forloop.index }}"
                  class="mujo-bs-slide{% if show_slider %} slider__slide{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {% render 'mujo-product-card', product: product, section_id: section.id, lazy_load: lazy_load, show_badge: section.settings.show_badge, badge_text: section.settings.badge_text %}
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- elsif section.settings.collection != blank -%}
            {%- for product in section.settings.collection.products limit: 8 -%}
              {%- assign lazy_load = false -%}
              {%- if forloop.index > 2 -%}
                {%- assign lazy_load = true -%}
              {%- endif -%}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="mujo-bs-slide{% if show_slider %} slider__slide{% endif %}"
              >
                {% render 'mujo-product-card', product: product, section_id: section.id, lazy_load: lazy_load, show_badge: section.settings.show_badge, badge_text: section.settings.badge_text %}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for product in collections.all.products limit: 8 -%}
              {%- assign lazy_load = false -%}
              {%- if forloop.index > 2 -%}
                {%- assign lazy_load = true -%}
              {%- endif -%}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="mujo-bs-slide{% if show_slider %} slider__slide{% endif %}"
              >
                {% render 'mujo-product-card', product: product, section_id: section.id, lazy_load: lazy_load, show_badge: section.settings.show_badge, badge_text: section.settings.badge_text %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- if show_slider -%}
          <div class="slider-buttons">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ product_count }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
            </button>
          </div>
        {%- endif -%}
      </slider-component>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "New In",
  "tag": "section",
  "class": "section mujo-new-in-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New In"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Optional — pulls up to 8 products from this collection. Ignored if you add individual Product blocks below instead (those take priority)."
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "\"Shop All\" label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "\"Shop All\" link",
      "info": "Usually your New Release/New In collection or page"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge on product cards",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "New"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New In"
    }
  ]
}
{% endschema %}
