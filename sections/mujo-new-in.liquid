{%- comment -%}
  MUJŌ CO. — New In
  Pick one collection (e.g. your "New Release" collection) and it
  renders as a static grid — deliberately not a carousel — so it
  reads as visually distinct from the Best Sellers section.
{%- endcomment -%}

{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Urbanist:wght@400;500;600&display=swap');

  .mujo-new-in-{{ section.id }} {
    background: #F1EFEA;
    padding: 72px 0;
  }

  .mujo-new-in-{{ section.id }} .mujo-ni-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .mujo-new-in-{{ section.id }} .mujo-ni-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }

  .mujo-new-in-{{ section.id }} .mujo-ni-heading {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 3vw, 40px);
    color: #1B1A18;
    margin: 0;
  }

  .mujo-new-in-{{ section.id }} .mujo-ni-shopall {
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #1B1A18;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .mujo-new-in-{{ section.id }} .mujo-ni-shopall:hover {
    border-color: #1B1A18;
  }

  .mujo-new-in-{{ section.id }} .mujo-ni-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: 32px 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 989px) {
    .mujo-new-in-{{ section.id }} .mujo-ni-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .mujo-new-in-{{ section.id }} {
      padding: 48px 0;
    }
    .mujo-new-in-{{ section.id }} .mujo-ni-inner {
      padding: 0 24px;
    }
    .mujo-new-in-{{ section.id }} .mujo-ni-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: 24px 16px;
    }
  }

  /* Editorial card treatment, matching Best Sellers but on a static grid */
  .mujo-new-in-{{ section.id }} .card,
  .mujo-new-in-{{ section.id }} .card__inner {
    box-shadow: none;
    border: none;
    border-radius: 0;
    background: transparent;
  }
  .mujo-new-in-{{ section.id }} .card__media {
    background: #E5E2D9;
  }
  .mujo-new-in-{{ section.id }} .card__content {
    padding: 16px 0 0;
  }
  .mujo-new-in-{{ section.id }} .card__heading {
    font-size: 14px;
    margin: 0;
  }
  .mujo-new-in-{{ section.id }} .card__heading a {
    font-family: 'Urbanist', sans-serif;
    font-weight: 500;
    color: #1B1A18;
    text-decoration: none;
  }
  .mujo-new-in-{{ section.id }} .price {
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    color: #6B6862;
    margin-top: 4px;
  }
  .mujo-new-in-{{ section.id }} .quick-add__submit {
    background: #EEC9FD;
    color: #1B1A18;
    border-radius: 2px;
    box-shadow: none;
  }
  .mujo-new-in-{{ section.id }} .quick-add__submit:hover {
    background: #E2AEF9;
  }
{%- endstyle -%}

<div class="mujo-new-in-{{ section.id }}">
  <div class="mujo-ni-inner">
    <div class="mujo-ni-header">
      {%- if section.settings.heading != blank -%}
        <h2 class="mujo-ni-heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.shop_all_link != blank -%}
        <a href="{{ section.settings.shop_all_link }}" class="mujo-ni-shopall">
          {{ section.settings.shop_all_label | default: 'Shop All' }}
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank -%}
      <ul class="mujo-ni-grid" role="list">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          <li>
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'portrait',
              show_secondary_image: true,
              section_id: section.id,
              quick_add: section.settings.quick_add,
              lazy_load: forloop.index > 4
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "New In",
  "tag": "section",
  "class": "section mujo-new-in-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New In"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Point this at your newest-releases collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns — mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "\"Shop All\" label",
      "default": "Shop All"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "\"Shop All\" link"
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add",
      "default": "none",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" },
        { "value": "bulk", "label": "Bulk" }
      ]
    }
  ],
  "presets": [
    {
      "name": "New In"
    }
  ]
}
{% endschema %}
