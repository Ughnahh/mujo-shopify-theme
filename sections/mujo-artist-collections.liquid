{%- comment -%}
  MUJŌ CO. — Shop by Artist: editorial split layout. Artist names are
  stacked on the left; hovering (or focusing, for keyboard users; or
  tapping, on touch) one crossfades in 4 products from that artist's
  Shopify collection on the right, in a 2x2 grid. Before any hover,
  the right side shows a merchant-chosen default image — never a
  specific artist by default. One single "Explore Collection" CTA for
  the whole section, not per artist.

  Uses the same mujo-product-card snippet as Best Sellers/New In, with
  swatches and Add to Cart suppressed (swatches via scoped CSS, Add to
  Cart by passing add_to_cart_style: 'none', a value the snippet
  doesn't recognize so neither of its button variants render) — kept
  purely as a photo + name + price preview.

  Self-contained: its own scoped styles/markup/script. Does not touch
  Best Sellers, New In, Hero, Shop All, the header, or any other
  section.
{%- endcomment -%}

{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Urbanist:wght@400;500;600&display=swap');

  .mujo-sba-{{ section.id }} {
    background: #FAFAF7;
    padding: 80px 0;
  }

  .mujo-sba-{{ section.id }} .mujo-sba-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .mujo-sba-{{ section.id }} .mujo-sba-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media screen and (min-width: 990px) {
    .mujo-sba-{{ section.id }} .mujo-sba-layout {
      grid-template-columns: 30% 1fr;
      gap: 64px;
      align-items: center;
    }
  }

  /* Left: eyebrow label + editorial artist list */
  .mujo-sba-{{ section.id }} .mujo-sba-eyebrow {
    font-family: 'Urbanist', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6B6862;
    margin: 0 0 20px;
  }

  .mujo-sba-{{ section.id }} .mujo-sba-nav {
    display: flex;
    flex-direction: row;
    gap: 22px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 6px;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-nav::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .mujo-sba-{{ section.id }} .mujo-sba-nav {
      flex-direction: column;
      gap: 22px;
      overflow-x: visible;
      padding-bottom: 0;
    }
  }

  .mujo-sba-{{ section.id }} .mujo-sba-tab {
    flex: 0 0 auto;
    appearance: none;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    font-size: 20px;
    color: #6B6862;
    padding: 2px 2px 6px;
    position: relative;
    transition: color 0.2s ease;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-tab::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 0;
    height: 1px;
    background: #1B1A18;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-tab:hover,
  .mujo-sba-{{ section.id }} .mujo-sba-tab:focus-visible {
    color: #1B1A18;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-tab:focus-visible {
    outline: 1px solid #1B1A18;
    outline-offset: 4px;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-tab.is-active {
    color: #1B1A18;
    font-weight: 600;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-tab.is-active::after {
    transform: scaleX(1);
  }

  @media screen and (min-width: 990px) {
    .mujo-sba-{{ section.id }} .mujo-sba-tab {
      font-size: 26px;
    }
  }

  /* Right: fixed-shape stage, panels crossfade in place */
  .mujo-sba-{{ section.id }} .mujo-sba-stage {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: #E5E2D9;
  }

  .mujo-sba-{{ section.id }} .mujo-sba-panel {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.45s ease;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-panel.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mujo-sba-{{ section.id }} .mujo-sba-default {
    display: block;
    width: 100%;
    height: 100%;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-default img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-default-label {
    position: absolute;
    left: 20px;
    bottom: 20px;
    font-family: 'Urbanist', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #FAFAF7;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.5);
  }

  .mujo-sba-{{ section.id }} .mujo-sba-products {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 2px;
    width: 100%;
    height: 100%;
  }

  /* Product preview card — same visual language as Best Sellers, with
     swatches and Add to Cart stripped out for a quiet catalog-preview
     feel. */
  .mujo-sba-{{ section.id }} .mujo-pc {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-media {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    background-color: #E5E2D9;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.4s ease;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-image-secondary {
    opacity: 0;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(250, 250, 247, 0.94) 0%,
      rgba(250, 250, 247, 0.7) 26%,
      rgba(250, 250, 247, 0) 55%
    );
    pointer-events: none;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-badge {
    display: none;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-title {
    font-family: 'Urbanist', sans-serif;
    font-weight: 600;
    font-size: 12px;
    line-height: 1.15;
    color: #1B1A18;
    text-decoration: none;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-subtitle {
    display: none;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-price {
    font-family: 'Urbanist', sans-serif;
    font-size: 11px;
    font-weight: 500;
    color: #6B6862;
    margin-top: 1px;
  }
  .mujo-sba-{{ section.id }} .mujo-pc-swatches,
  .mujo-sba-{{ section.id }} .mujo-pc-add-to-bag-wrap {
    display: none !important;
  }

  @media (hover: hover) and (pointer: fine) {
    .mujo-sba-{{ section.id }} .mujo-pc:hover .mujo-pc-image-primary {
      opacity: 0;
    }
    .mujo-sba-{{ section.id }} .mujo-pc:hover .mujo-pc-image-secondary {
      opacity: 1;
    }
  }

  /* Single section-wide CTA */
  .mujo-sba-{{ section.id }} .mujo-sba-cta-row {
    margin-top: 40px;
    text-align: center;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-cta {
    font-family: 'Urbanist', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1B1A18;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid #1B1A18;
    padding-bottom: 3px;
    transition: opacity 0.2s ease;
  }
  .mujo-sba-{{ section.id }} .mujo-sba-cta:hover {
    opacity: 0.6;
  }

  @media screen and (max-width: 749px) {
    .mujo-sba-{{ section.id }} {
      padding: 48px 0;
    }
    .mujo-sba-{{ section.id }} .mujo-sba-inner {
      padding: 0 24px;
    }
    .mujo-sba-{{ section.id }} .mujo-sba-tab {
      font-size: 17px;
    }
    .mujo-sba-{{ section.id }} .mujo-sba-cta-row {
      margin-top: 32px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign artist_blocks = section.blocks | where: 'type', 'artist'
-%}

<div class="mujo-sba-{{ section.id }}" id="ShopByArtist-{{ section.id }}">
  <div class="mujo-sba-inner">
    <div class="mujo-sba-layout">
      <div>
        {%- if section.settings.heading != blank -%}
          <p class="mujo-sba-eyebrow">{{ section.settings.heading }}</p>
        {%- endif -%}

        {%- if artist_blocks.size > 0 -%}
          <div class="mujo-sba-nav" role="tablist" aria-orientation="vertical" aria-label="{{ section.settings.heading | default: 'Shop by artist' }}">
            {%- for block in artist_blocks -%}
              <button
                type="button"
                role="tab"
                id="mujo-sba-tab-{{ section.id }}-{{ forloop.index0 }}"
                class="mujo-sba-tab"
                aria-selected="false"
                aria-controls="mujo-sba-panel-{{ section.id }}-{{ forloop.index0 }}"
                tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                data-mujo-sba-tab="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.artist_name | default: 'Artist' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="mujo-sba-stage" aria-live="polite">
        <div
          class="mujo-sba-panel is-active"
          data-mujo-sba-default
        >
          {%- if section.settings.default_image -%}
            <span class="mujo-sba-default">
              <img
                src="{{ section.settings.default_image | image_url: width: 1200 }}"
                srcset="{{ section.settings.default_image | image_url: width: 600 }} 600w, {{ section.settings.default_image | image_url: width: 900 }} 900w, {{ section.settings.default_image | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 989px) 100vw, 68vw"
                loading="eager"
                alt="{{ section.settings.default_image.alt | default: section.settings.heading | escape }}"
                width="1200"
                height="1200"
              >
            </span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <span class="mujo-sba-default-label">{{ section.settings.heading }}</span>
          {%- endif -%}
        </div>

        {%- for block in artist_blocks -%}
          {%- assign artist_collection = block.settings.collection -%}
          <div
            id="mujo-sba-panel-{{ section.id }}-{{ forloop.index0 }}"
            class="mujo-sba-panel"
            role="tabpanel"
            aria-labelledby="mujo-sba-tab-{{ section.id }}-{{ forloop.index0 }}"
            data-mujo-sba-panel="{{ forloop.index0 }}"
          >
            {%- if artist_collection.products.size > 0 -%}
              <div class="mujo-sba-products">
                {%- for product in artist_collection.products limit: 4 -%}
                  {% render 'mujo-product-card',
                    product: product,
                    section_id: section.id,
                    lazy_load: true,
                    show_badge: false,
                    add_to_cart_style: 'none'
                  %}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.explore_link != blank -%}
      <div class="mujo-sba-cta-row">
        <a href="{{ section.settings.explore_link }}" class="mujo-sba-cta">
          {{ section.settings.explore_label | default: 'Explore Collection' }}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('ShopByArtist-{{ section.id }}');
    if (!root) return;

    var nav = root.querySelector('.mujo-sba-nav');
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-mujo-sba-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-mujo-sba-panel]'));
    var defaultPanel = root.querySelector('[data-mujo-sba-default]');
    if (!nav || !tabs.length || !panels.length || !defaultPanel) return;

    function show(index) {
      tabs.forEach(function (tab, i) {
        var isActive = index !== null && i === index;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      panels.forEach(function (panel, i) {
        panel.classList.toggle('is-active', index !== null && i === index);
      });

      defaultPanel.classList.toggle('is-active', index === null);
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('mouseenter', function () {
        show(i);
      });
      tab.addEventListener('focus', function () {
        show(i);
      });
      tab.addEventListener('click', function (event) {
        event.preventDefault();
        show(i);
      });

      tab.addEventListener('keydown', function (event) {
        var lastIndex = tabs.length - 1;
        var nextIndex = null;

        switch (event.key) {
          case 'ArrowDown':
          case 'ArrowRight':
            nextIndex = i === lastIndex ? 0 : i + 1;
            break;
          case 'ArrowUp':
          case 'ArrowLeft':
            nextIndex = i === 0 ? lastIndex : i - 1;
            break;
          case 'Home':
            nextIndex = 0;
            break;
          case 'End':
            nextIndex = lastIndex;
            break;
          default:
            return;
        }

        event.preventDefault();
        tabs[nextIndex].focus();
      });
    });

    nav.addEventListener('mouseleave', function () {
      show(null);
    });

    nav.addEventListener('focusout', function (event) {
      if (!nav.contains(event.relatedTarget)) {
        show(null);
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Shop by Artist",
  "tag": "section",
  "class": "section mujo-shop-by-artist-section",
  "max_blocks": 7,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Artist"
    },
    {
      "type": "header",
      "content": "Default preview (shown before hover)"
    },
    {
      "type": "image_picker",
      "id": "default_image",
      "label": "Default image"
    },
    {
      "type": "header",
      "content": "Explore Collection CTA"
    },
    {
      "type": "url",
      "id": "explore_link",
      "label": "Link",
      "info": "Usually your Artist Collections page"
    },
    {
      "type": "text",
      "id": "explore_label",
      "label": "Link text",
      "default": "Explore Collection"
    }
  ],
  "blocks": [
    {
      "type": "artist",
      "name": "Artist",
      "settings": [
        {
          "type": "text",
          "id": "artist_name",
          "label": "Artist name",
          "default": "Artist"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Artist",
      "blocks": [
        { "type": "artist", "settings": { "artist_name": "RM" } },
        { "type": "artist", "settings": { "artist_name": "Jin" } },
        { "type": "artist", "settings": { "artist_name": "SUGA" } },
        { "type": "artist", "settings": { "artist_name": "j-hope" } },
        { "type": "artist", "settings": { "artist_name": "Jimin" } },
        { "type": "artist", "settings": { "artist_name": "V" } },
        { "type": "artist", "settings": { "artist_name": "Jungkook" } }
      ]
    }
  ]
}
{% endschema %}
