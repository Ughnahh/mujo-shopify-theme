{%- comment -%}
  MUJŌ CO. — Artist Collections: editorial split-screen artist
  directory + featured collection. NOT a carousel and NOT a product
  grid — an interactive tab pattern (vertical list on desktop,
  horizontal scroll strip on mobile) where picking an artist swaps
  which of their Shopify collections is shown large on the other
  side, with a small strip of that collection's own product photos
  as a taste of what's inside (no titles, no prices — just images).

  Self-contained: its own scoped styles/markup/script, one Shopify
  section instance per page. Does not touch Best Sellers, Hero, Shop
  All, the header, or any other section.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Urbanist:wght@400;500;600&display=swap');

  .mujo-ac-{{ section.id }} {
    background: #FAFAF7;
    padding: 72px 0;
  }

  .mujo-ac-{{ section.id }} .mujo-ac-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .mujo-ac-{{ section.id }} .mujo-ac-heading {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 3vw, 40px);
    color: #1B1A18;
    margin: 0 0 40px;
  }

  /* Desktop: 30/70 split */
  .mujo-ac-{{ section.id }} .mujo-ac-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }

  @media screen and (min-width: 990px) {
    .mujo-ac-{{ section.id }} .mujo-ac-layout {
      grid-template-columns: 30% 1fr;
      gap: 56px;
      align-items: stretch;
    }
  }

  /* Artist selector — editorial list, not buttons */
  .mujo-ac-{{ section.id }} .mujo-ac-nav {
    display: flex;
    flex-direction: row;
    gap: 20px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
    border-bottom: 1px solid rgba(27, 26, 24, 0.1);
  }
  .mujo-ac-{{ section.id }} .mujo-ac-nav::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 990px) {
    .mujo-ac-{{ section.id }} .mujo-ac-nav {
      flex-direction: column;
      gap: 4px;
      overflow-x: visible;
      border-bottom: none;
      padding-bottom: 0;
    }
  }

  .mujo-ac-{{ section.id }} .mujo-ac-tab {
    flex: 0 0 auto;
    appearance: none;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: 'Urbanist', sans-serif;
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: #6B6862;
    padding: 10px 2px;
    position: relative;
    transition: color 0.2s ease, font-weight 0.2s ease;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-tab::before {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 4px;
    height: 1px;
    background: #1B1A18;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-tab:hover {
    color: #1B1A18;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-tab:focus-visible {
    outline: 1px solid #1B1A18;
    outline-offset: 3px;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-tab.is-active {
    color: #1B1A18;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-tab.is-active::before {
    transform: scaleX(1);
  }

  @media screen and (min-width: 990px) {
    .mujo-ac-{{ section.id }} .mujo-ac-tab {
      font-size: 18px;
      padding: 14px 0 14px 18px;
    }
    .mujo-ac-{{ section.id }} .mujo-ac-tab::before {
      left: 0;
      right: auto;
      top: 14px;
      bottom: 14px;
      height: auto;
      width: 2px;
      transform: scaleY(0);
      transform-origin: top;
    }
    .mujo-ac-{{ section.id }} .mujo-ac-tab.is-active::before {
      transform: scaleY(1);
    }
  }

  /* Featured collection stage */
  .mujo-ac-{{ section.id }} .mujo-ac-stage {
    position: relative;
  }

  .mujo-ac-{{ section.id }} .mujo-ac-panel {
    display: grid;
    gap: 20px;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-panel[hidden] {
    display: none;
  }

  .mujo-ac-{{ section.id }} .mujo-ac-media {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: #E5E2D9;
    aspect-ratio: 16 / 10;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-media:hover img {
    transform: scale(1.03);
  }

  .mujo-ac-{{ section.id }} .mujo-ac-content {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-collection-name {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(22px, 2.4vw, 30px);
    color: #1B1A18;
    margin: 0;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-desc {
    font-family: 'Urbanist', sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #6B6862;
    margin: 0;
    max-width: 46em;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-shop-link {
    font-family: 'Urbanist', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1B1A18;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border-bottom: 1px solid #1B1A18;
    padding-bottom: 2px;
    width: fit-content;
    transition: opacity 0.2s ease;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-shop-link:hover {
    opacity: 0.6;
  }

  /* Small taste-of-the-collection strip — plain images, no card
     chrome, no names, no prices. */
  .mujo-ac-{{ section.id }} .mujo-ac-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-top: 6px;
    max-width: 420px;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-thumb {
    display: block;
    position: relative;
    overflow: hidden;
    background-color: #E5E2D9;
    aspect-ratio: 1 / 1;
  }
  .mujo-ac-{{ section.id }} .mujo-ac-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .mujo-ac-{{ section.id }} {
      padding: 48px 0;
    }
    .mujo-ac-{{ section.id }} .mujo-ac-inner {
      padding: 0 24px;
    }
    .mujo-ac-{{ section.id }} .mujo-ac-heading {
      margin-bottom: 24px;
    }
    .mujo-ac-{{ section.id }} .mujo-ac-media {
      aspect-ratio: 4 / 5;
    }
    .mujo-ac-{{ section.id }} .mujo-ac-thumbs {
      max-width: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign artist_blocks = section.blocks | where: 'type', 'artist'
-%}

<div class="mujo-ac-{{ section.id }}" id="ArtistCollections-{{ section.id }}">
  <div class="mujo-ac-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="mujo-ac-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if artist_blocks.size > 0 -%}
      <div class="mujo-ac-layout">
        <div class="mujo-ac-nav" role="tablist" aria-orientation="vertical" aria-label="{{ section.settings.heading | default: 'Artist collections' }}">
          {%- for block in artist_blocks -%}
            <button
              type="button"
              role="tab"
              id="mujo-ac-tab-{{ section.id }}-{{ forloop.index0 }}"
              class="mujo-ac-tab{% if forloop.first %} is-active{% endif %}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="mujo-ac-panel-{{ section.id }}-{{ forloop.index0 }}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-mujo-ac-tab="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.artist_name | default: 'Artist' }}
            </button>
          {%- endfor -%}
        </div>

        <div class="mujo-ac-stage">
          {%- for block in artist_blocks -%}
            {%- assign artist_collection = block.settings.collection -%}
            <div
              id="mujo-ac-panel-{{ section.id }}-{{ forloop.index0 }}"
              class="mujo-ac-panel{% if forloop.first %} is-active{% endif %}"
              role="tabpanel"
              aria-labelledby="mujo-ac-tab-{{ section.id }}-{{ forloop.index0 }}"
              data-mujo-ac-panel="{{ forloop.index0 }}"
              {% unless forloop.first %}hidden{% endunless %}
              tabindex="0"
            >
              <a href="{{ artist_collection.url | default: '#' }}" class="mujo-ac-media" aria-label="{{ artist_collection.title | default: block.settings.artist_name | escape }}">
                {%- if artist_collection.featured_image -%}
                  <img
                    src="{{ artist_collection.featured_image | image_url: width: 1600 }}"
                    srcset="{{ artist_collection.featured_image | image_url: width: 800 }} 800w, {{ artist_collection.featured_image | image_url: width: 1200 }} 1200w, {{ artist_collection.featured_image | image_url: width: 1600 }} 1600w"
                    sizes="(max-width: 989px) 100vw, 68vw"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    alt="{{ artist_collection.featured_image.alt | default: artist_collection.title | escape }}"
                    width="1600"
                    height="1000"
                  >
                {%- endif -%}
              </a>

              <div class="mujo-ac-content">
                <h3 class="mujo-ac-collection-name">
                  {{ artist_collection.title | default: block.settings.artist_name }}
                </h3>
                {%- if block.settings.description != blank -%}
                  <p class="mujo-ac-desc">{{ block.settings.description }}</p>
                {%- endif -%}
                <a href="{{ artist_collection.url | default: '#' }}" class="mujo-ac-shop-link">
                  {{ section.settings.shop_label | default: 'Shop Collection' }}
                  <span aria-hidden="true">→</span>
                </a>

                {%- if artist_collection.products.size > 0 -%}
                  <div class="mujo-ac-thumbs" aria-hidden="true">
                    {%- for product in artist_collection.products limit: 4 -%}
                      <span class="mujo-ac-thumb">
                        {%- if product.featured_image -%}
                          <img
                            src="{{ product.featured_image | image_url: width: 300 }}"
                            loading="lazy"
                            alt=""
                            width="300"
                            height="300"
                          >
                        {%- endif -%}
                      </span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('ArtistCollections-{{ section.id }}');
    if (!root) return;

    var tabs = Array.prototype.slice.call(root.querySelectorAll('[data-mujo-ac-tab]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[data-mujo-ac-panel]'));
    if (!tabs.length || !panels.length) return;

    function activate(index, options) {
      var focusTab = !options || options.focusTab !== false;

      tabs.forEach(function (tab, i) {
        var isActive = i === index;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
      });

      panels.forEach(function (panel, i) {
        var isActive = i === index;
        panel.classList.toggle('is-active', isActive);
        if (isActive) {
          panel.removeAttribute('hidden');
          var lazyImg = panel.querySelector('img[loading="lazy"]');
          if (lazyImg && lazyImg.dataset.mujoAcLoaded !== 'true') {
            lazyImg.loading = 'eager';
            lazyImg.dataset.mujoAcLoaded = 'true';
          }
        } else {
          panel.setAttribute('hidden', '');
        }
      });

      if (focusTab) tabs[index].focus();
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        activate(i, { focusTab: false });
      });

      tab.addEventListener('keydown', function (event) {
        var lastIndex = tabs.length - 1;
        var nextIndex = null;

        switch (event.key) {
          case 'ArrowDown':
          case 'ArrowRight':
            nextIndex = i === lastIndex ? 0 : i + 1;
            break;
          case 'ArrowUp':
          case 'ArrowLeft':
            nextIndex = i === 0 ? lastIndex : i - 1;
            break;
          case 'Home':
            nextIndex = 0;
            break;
          case 'End':
            nextIndex = lastIndex;
            break;
          default:
            return;
        }

        event.preventDefault();
        activate(nextIndex);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Artist Collections",
  "tag": "section",
  "class": "section mujo-artist-collections-section",
  "max_blocks": 7,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Artist Collections"
    },
    {
      "type": "text",
      "id": "shop_label",
      "label": "Link text",
      "default": "Shop Collection"
    }
  ],
  "blocks": [
    {
      "type": "artist",
      "name": "Artist",
      "settings": [
        {
          "type": "text",
          "id": "artist_name",
          "label": "Artist name",
          "default": "Artist"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Artist Collections",
      "blocks": [
        { "type": "artist", "settings": { "artist_name": "RM" } },
        { "type": "artist", "settings": { "artist_name": "Jin" } },
        { "type": "artist", "settings": { "artist_name": "SUGA" } },
        { "type": "artist", "settings": { "artist_name": "j-hope" } },
        { "type": "artist", "settings": { "artist_name": "Jimin" } },
        { "type": "artist", "settings": { "artist_name": "V" } },
        { "type": "artist", "settings": { "artist_name": "Jungkook" } }
      ]
    }
  ]
}
{% endschema %}
