{%- comment -%}
  MUJŌ CO. — standalone "Shop All Products" page. Fully separate from
  the homepage Best Seller / New In sections and from any collection
  template: this only ever renders on the dedicated Page it's attached
  to, so nothing here can affect any other page.

  Always lists every product in the store (collections.all.products) —
  the category nav at the top is just links out to real collections,
  it doesn't filter this grid.
{%- endcomment -%}

{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<script>
  if (!customElements.get('mujo-product-card')) {
    class MujoProductCard extends HTMLElement {
      connectedCallback() {
        // Delegate from the custom element itself, and look up
        // children lazily inside the handler (not here) — during
        // initial HTML parsing this element can be upgraded the
        // instant its opening tag is seen, before its own children
        // (swatches, image, price) have been parsed yet.
        this.addEventListener('click', (event) => {
          const swatch = event.target.closest('.mujo-pc-swatch');
          if (swatch && this.contains(swatch)) {
            this.selectSwatch(swatch);
          }
        });

        this.addEventListener('mouseleave', () => {
          this.clearImageOverride();
        });
      }

      clearImageOverride() {
        const primary = this.querySelector('.mujo-pc-image-primary');
        const secondary = this.querySelector('.mujo-pc-image-secondary');
        if (primary) primary.style.opacity = '';
        if (secondary) secondary.style.opacity = '';
      }

      selectSwatch(swatch) {
        const swatches = this.querySelectorAll('.mujo-pc-swatch');
        const image = this.querySelector('.mujo-pc-image-primary');
        const secondaryImage = this.querySelector('.mujo-pc-image-secondary');
        const priceEl = this.querySelector('.mujo-pc-price');
        const variantInput = this.querySelector('.mujo-pc-variant-id');
        const addButton = this.querySelector('.mujo-pc-add-to-bag');
        const addLabel = this.querySelector('.mujo-pc-add-to-bag-label');

        swatches.forEach((s) => {
          const isSelected = s === swatch;
          s.classList.toggle('is-selected', isSelected);
          s.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
        });

        const available = swatch.dataset.available === 'true';
        const colorLabel = swatch.getAttribute('aria-label') || '';

        if (image && swatch.dataset.image) {
          image.src = swatch.dataset.image;
          if (swatch.dataset.imageSrcset) {
            image.srcset = swatch.dataset.imageSrcset;
          }
          image.style.opacity = '1';
          if (secondaryImage) secondaryImage.style.opacity = '0';
        }

        if (variantInput) {
          variantInput.value = swatch.dataset.variantId;
        }

        if (addButton) {
          addButton.disabled = !available;
          const baseLabel = available ? 'Add to Cart' : 'Sold out';
          addButton.setAttribute('aria-label', baseLabel + (colorLabel ? ' — ' + colorLabel : ''));
        }
        if (addLabel) {
          addLabel.textContent = available ? 'Add to Cart' : 'Sold out';
        }

        if (priceEl) {
          const price = swatch.dataset.price;
          const comparePrice = swatch.dataset.comparePrice;
          if (comparePrice) {
            priceEl.innerHTML =
              '<span class="mujo-pc-price-sale">' + price + '</span> ' +
              '<s class="mujo-pc-price-compare">' + comparePrice + '</s>';
          } else {
            priceEl.innerHTML = '<span class="mujo-pc-price-regular">' + price + '</span>';
          }
        }
      }
    }
    customElements.define('mujo-product-card', MujoProductCard);
  }
</script>

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Urbanist:wght@400;500;600&display=swap');

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Category nav: plain text links, no button chrome */
  .section-{{ section.id }}-padding .mujo-category-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 10px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(27, 26, 24, 0.1);
    font-family: 'Urbanist', sans-serif;
    font-size: 14px;
  }
  .section-{{ section.id }}-padding .mujo-category-link {
    color: #6B6A66;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .section-{{ section.id }}-padding .mujo-category-link:hover {
    color: #1B1A18;
  }
  .section-{{ section.id }}-padding .mujo-category-link.is-active {
    color: #1B1A18;
    font-weight: 600;
    border-bottom-color: #1B1A18;
  }
  .section-{{ section.id }}-padding .mujo-category-sep {
    color: #CFCCC3;
  }

  .section-{{ section.id }}-padding .product-grid {
    gap: 24px 14px;
  }

  .section-{{ section.id }}-padding .grid__item {
    padding: 0;
    background: transparent;
  }

  /* Unified editorial product card: image and info are one
     continuous block, no gap/border/shadow between them. */
  .section-{{ section.id }}-padding .mujo-pc {
    display: block;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .section-{{ section.id }}-padding .mujo-pc-media {
    position: relative;
    overflow: hidden;
    background-color: #E5E2D9;
    aspect-ratio: 4 / 5;
  }
  .section-{{ section.id }}-padding .mujo-pc-media-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .section-{{ section.id }}-padding .mujo-pc-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.4s ease;
  }
  .section-{{ section.id }}-padding .mujo-pc-image-secondary {
    opacity: 0;
  }

  .section-{{ section.id }}-padding .mujo-pc-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(250, 250, 247, 0.96) 0%,
      rgba(250, 250, 247, 0.82) 30%,
      rgba(250, 250, 247, 0) 62%
    );
    pointer-events: none;
  }

  .section-{{ section.id }}-padding .mujo-pc-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    background: #C9A7E8;
    color: #1B1A18;
    font-family: 'Urbanist', sans-serif;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 2px;
  }

  .section-{{ section.id }}-padding .mujo-pc-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: 16px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .section-{{ section.id }}-padding .mujo-pc-title {
    font-family: 'Urbanist', sans-serif;
    font-weight: 600;
    font-size: 14px;
    line-height: 1.1;
    letter-spacing: 0.01em;
    color: #1B1A18;
    text-decoration: none;
  }
  .section-{{ section.id }}-padding .mujo-pc-subtitle {
    font-family: 'Urbanist', sans-serif;
    font-size: 12px;
    line-height: 1.1;
    color: #B27BCF;
  }
  .section-{{ section.id }}-padding .mujo-pc-price {
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #1B1A18;
    margin-top: 2px;
  }
  .section-{{ section.id }}-padding .mujo-pc-price-sale {
    color: #1B1A18;
  }
  .section-{{ section.id }}-padding .mujo-pc-price-compare {
    color: #8A8579;
    margin-left: 4px;
  }

  .section-{{ section.id }}-padding .mujo-pc-swatches {
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }
  .section-{{ section.id }}-padding .mujo-pc-swatch {
    width: 16px;
    height: 16px;
    padding: 0;
    border-radius: 50%;
    position: relative;
    border: 1.5px solid rgba(27, 26, 24, 0.25);
    background-color: #E5E2D9;
    cursor: pointer;
  }
  .section-{{ section.id }}-padding .mujo-pc-swatch.is-selected::after {
    content: '';
    position: absolute;
    inset: -4px;
    border: 1.5px solid #1B1A18;
    border-radius: 50%;
  }

  /* Add to Cart: plain transparent text below the swatches — no
     fill, border, or box. Hidden by default, revealed on hover on
     desktop; always visible on touch devices since hover doesn't
     exist there. */
  .section-{{ section.id }}-padding .mujo-pc-add-to-bag-wrap {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    margin-top: 0;
    transition: max-height 0.25s ease, opacity 0.2s ease, margin-top 0.25s ease;
  }
  .section-{{ section.id }}-padding .mujo-pc-form {
    margin: 0;
  }
  .section-{{ section.id }}-padding .mujo-pc-add-to-bag {
    display: inline-block;
    font-family: 'Urbanist', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #1B1A18;
    background: none;
    border: none;
    box-shadow: none;
    padding: 4px 0;
    margin: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
    cursor: pointer;
  }
  .section-{{ section.id }}-padding .mujo-pc-add-to-bag:hover {
    color: #6B6862;
  }
  .section-{{ section.id }}-padding .mujo-pc-add-to-bag:disabled {
    color: #B7B2A9;
    cursor: default;
  }
  .section-{{ section.id }}-padding .mujo-pc-add-to-bag .loading__spinner {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .section-{{ section.id }}-padding .mujo-pc:hover .mujo-pc-add-to-bag-wrap {
      max-height: 28px;
      opacity: 1;
      margin-top: 6px;
    }
    .section-{{ section.id }}-padding .mujo-pc:hover .mujo-pc-image-primary {
      opacity: 0;
    }
    .section-{{ section.id }}-padding .mujo-pc:hover .mujo-pc-image-secondary {
      opacity: 1;
    }
  }
  @media (hover: none) {
    .section-{{ section.id }}-padding .mujo-pc-add-to-bag-wrap {
      max-height: 28px;
      opacity: 1;
      margin-top: 6px;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }}-padding .mujo-pc-badge {
      font-size: 9px;
      padding: 4px 8px;
    }
    .section-{{ section.id }}-padding .mujo-pc-title {
      font-size: 13px;
    }
    .section-{{ section.id }}-padding .mujo-pc-subtitle {
      font-size: 11px;
    }
    .section-{{ section.id }}-padding .mujo-pc-price {
      font-size: 12px;
    }
    .section-{{ section.id }}-padding .mujo-pc-swatch {
      width: 14px;
      height: 14px;
    }
    .section-{{ section.id }}-padding .mujo-pc-add-to-bag {
      font-size: 11px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">

  {%- assign nav_blocks = section.blocks | where: 'type', 'nav_link' -%}
  {%- if nav_blocks.size > 0 -%}
    <nav class="mujo-category-nav page-width" aria-label="Shop by category">
      {%- for block in nav_blocks -%}
        <a
          href="{{ block.settings.link | default: '#' }}"
          class="mujo-category-link{% if block.settings.link == collection.url %} is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label }}
        </a>
        {%- unless forloop.last -%}
          <span class="mujo-category-sep" aria-hidden="true">·</span>
        {%- endunless -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}

  {%- paginate collections.all.products by section.settings.products_per_page -%}
    <div class="collection page-width">
      <div class="loading-overlay gradient"></div>
      <ul
        id="product-grid"
        data-id="{{ section.id }}"
        class="
          grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
          grid--{{ section.settings.columns_desktop }}-col-desktop
        "
      >
        {%- for product in collections.all.products -%}
          {%- assign lazy_load = false -%}
          {%- if forloop.index > 2 -%}
            {%- assign lazy_load = true -%}
          {%- endif -%}
          <li
            class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {% render 'mujo-product-card',
              product: product,
              section_id: section.id,
              lazy_load: lazy_load,
              show_badge: section.settings.show_badge,
              badge_text: section.settings.badge_text,
              add_to_cart_style: 'text'
            %}
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        {% render 'pagination', paginate: paginate, anchor: '' %}
      {%- endif -%}
    </div>
  {%- endpaginate -%}

</div>

{% schema %}
{
  "name": "MUJŌ Shop All",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Number of columns on mobile",
      "options": [
        { "value": "1", "label": "1 column" },
        { "value": "2", "label": "2 columns" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Product card badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show badge on product cards",
      "default": false
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "New"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Category nav link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUJŌ Shop All",
      "blocks": [
        { "type": "nav_link", "settings": { "label": "Best Seller" } },
        { "type": "nav_link", "settings": { "label": "New In" } },
        { "type": "nav_link", "settings": { "label": "Collection by Artist" } },
        { "type": "nav_link", "settings": { "label": "Necklaces" } },
        { "type": "nav_link", "settings": { "label": "Rings" } },
        { "type": "nav_link", "settings": { "label": "Earrings" } }
      ]
    }
  ]
}
{% endschema %}
