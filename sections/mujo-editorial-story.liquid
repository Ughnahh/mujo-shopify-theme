{%- comment -%}
  MUJŌ CO. — Editorial / Product Story section
  Each block is one full-width "spread": image or video, heading,
  short description, supporting text, and a CTA. Blocks alternate
  image-left / image-right automatically, magazine-style. Use this
  for collection inspiration, materials, design details, or an
  artist/collection story.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Urbanist:wght@400;500;600&display=swap');

  .mujo-story-{{ section.id }} {
    background: #FAFAF7;
    padding: 72px 0;
  }

  .mujo-story-{{ section.id }} .mujo-story-spread {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .mujo-story-{{ section.id }} .mujo-story-spread + .mujo-story-spread {
    margin-top: 96px;
  }

  .mujo-story-{{ section.id }} .mujo-story-spread:nth-child(even) .mujo-story-media {
    order: 2;
  }

  .mujo-story-{{ section.id }} .mujo-story-media {
    position: relative;
    overflow: hidden;
    background-color: #E5E2D9;
    aspect-ratio: 4 / 5;
  }
  .mujo-story-{{ section.id }} .mujo-story-media img,
  .mujo-story-{{ section.id }} .mujo-story-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mujo-story-{{ section.id }} .mujo-story-text {
    max-width: 460px;
  }
  .mujo-story-{{ section.id }} .mujo-story-spread:nth-child(even) .mujo-story-text {
    order: 1;
    margin-left: auto;
  }

  .mujo-story-{{ section.id }} .mujo-story-heading {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.15;
    color: #1B1A18;
    margin: 0 0 20px;
  }

  .mujo-story-{{ section.id }} .mujo-story-description {
    font-family: 'Urbanist', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #1B1A18;
  }

  .mujo-story-{{ section.id }} .mujo-story-supporting {
    font-family: 'Urbanist', sans-serif;
    font-size: 14px;
    line-height: 1.7;
    color: #6B6862;
    margin-top: 16px;
  }

  .mujo-story-{{ section.id }} .mujo-story-cta {
    display: inline-block;
    margin-top: 28px;
    padding: 13px 32px;
    background: #EEC9FD;
    color: #1B1A18;
    font-family: 'Urbanist', sans-serif;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .mujo-story-{{ section.id }} .mujo-story-cta:hover {
    background: #E2AEF9;
    transform: translateY(-1px);
  }

  @media screen and (max-width: 989px) {
    .mujo-story-{{ section.id }} .mujo-story-spread {
      gap: 36px;
    }
  }

  @media screen and (max-width: 749px) {
    .mujo-story-{{ section.id }} {
      padding: 48px 0;
    }
    .mujo-story-{{ section.id }} .mujo-story-spread,
    .mujo-story-{{ section.id }} .mujo-story-spread:nth-child(even) {
      grid-template-columns: 1fr;
      padding: 0 24px;
    }
    .mujo-story-{{ section.id }} .mujo-story-spread:nth-child(even) .mujo-story-media,
    .mujo-story-{{ section.id }} .mujo-story-spread:nth-child(even) .mujo-story-text {
      order: initial;
    }
    .mujo-story-{{ section.id }} .mujo-story-text,
    .mujo-story-{{ section.id }} .mujo-story-spread:nth-child(even) .mujo-story-text {
      max-width: none;
      margin-left: 0;
    }
    .mujo-story-{{ section.id }} .mujo-story-spread + .mujo-story-spread {
      margin-top: 56px;
    }
  }
{%- endstyle -%}

<div class="mujo-story-{{ section.id }}">
  {%- for block in section.blocks -%}
    <div class="mujo-story-spread" {{ block.shopify_attributes }}>
      <div class="mujo-story-media">
        {%- if block.settings.video != blank -%}
          <video autoplay muted loop playsinline
            poster="{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 }}{% endif %}">
            {%- for source in block.settings.video.sources -%}
              {%- if source.mime_type == 'video/mp4' -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endif -%}
            {%- endfor -%}
          </video>
        {%- elsif block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            loading="lazy"
            alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
            width="1200"
            height="1500"
          >
        {%- endif -%}
      </div>
      <div class="mujo-story-text">
        {%- if block.settings.heading != blank -%}
          <h2 class="mujo-story-heading">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.description != blank -%}
          <div class="mujo-story-description">{{ block.settings.description }}</div>
        {%- endif -%}
        {%- if block.settings.supporting_text != blank -%}
          <div class="mujo-story-supporting">{{ block.settings.supporting_text }}</div>
        {%- endif -%}
        {%- if block.settings.cta_text != blank and block.settings.cta_link != blank -%}
          <a href="{{ block.settings.cta_link }}" class="mujo-story-cta">{{ block.settings.cta_text }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Editorial Story",
  "tag": "section",
  "class": "section mujo-editorial-story-section",
  "settings": [],
  "blocks": [
    {
      "type": "story",
      "name": "Story spread",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Used as-is if no video is uploaded, or as the video's poster frame"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (optional)",
          "info": "If uploaded, this plays instead of the image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The story behind it"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Tell the story behind this piece — the inspiration, the materials, the details that make it meaningful.</p>"
        },
        {
          "type": "richtext",
          "id": "supporting_text",
          "label": "Supporting text (optional)"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial Story",
      "blocks": [
        { "type": "story" }
      ]
    }
  ]
}
{% endschema %}
