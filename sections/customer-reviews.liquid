{% comment %}
  MUJŌ CO. – Simple manual review section
  One block = one review (like 1 order / 1 product review)
{% endcomment %}

<section class="mujo-reviews page-width">
  {% if section.settings.heading != blank %}
    <h2 class="mujo-reviews__heading">
      {{ section.settings.heading }}
    </h2>
  {% endif %}

  {% if section.blocks.size == 0 %}
    <p class="mujo-reviews__empty">
      No reviews yet. Be the first to review this product ✨
    </p>
  {% else %}
    <div class="mujo-reviews__list">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          {% assign stars = block.settings.rating | default: 5 %}

          <article class="mujo-review" {{ block.shopify_attributes }}>
            <header class="mujo-review__header">
              {% if block.settings.order_title != blank %}
                <h3 class="mujo-review__title">
                  {{ block.settings.order_title }}
                </h3>
              {% endif %}

              <div class="mujo-review__stars" aria-label="{{ stars }} out of 5 stars">
                {% for i in (1..5) %}
                  <span class="mujo-star{% if i <= stars %} mujo-star--filled{% endif %}">
                    ★
                  </span>
                {% endfor %}
              </div>
            </header>

            {% if block.settings.body != blank %}
              <p class="mujo-review__body">
                {{ block.settings.body }}
              </p>
            {% endif %}

            {% if block.settings.photo != blank %}
              <div class="mujo-review__photo">
                {{ block.settings.photo | image_url: width: 600 | image_tag: loading: 'lazy', alt: block.settings.order_title }}
              </div>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "MUJŌ Reviews",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "order_title",
          "label": "Order / Product title",
          "default": "BTS Festa Ring Set"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review text",
          "default": "Super pretty in person, sparkle is ✨ and packaging is so cute!"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Photo (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MUJŌ Reviews",
      "category": "MUJŌ"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.mujo-reviews {
  padding-top: 40px;
  padding-bottom: 40px;
}

.mujo-reviews__heading {
  text-align: center;
  font-size: 24px;
  margin-bottom: 24px;
}

.mujo-reviews__empty {
  text-align: center;
  color: #777;
  font-size: 14px;
}

.mujo-reviews__list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
}

@media screen and (min-width: 750px) {
  .mujo-reviews__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

.mujo-review {
  border-radius: 16px;
  border: 1px solid #eee;
  padding: 16px 18px;
  background-color: #ffffff;
}

.mujo-review__header {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  align-items: center;
  margin-bottom: 8px;
}

.mujo-review__title {
  font-size: 14px;
  font-weight: 600;
  margin: 0;
}

.mujo-review__stars {
  white-space: nowrap;
}

.mujo-star {
  font-size: 14px;
  opacity: 0.25;
}

.mujo-star--filled {
  opacity: 1;
  color: #CDA9E6; /* your lilac accent */
}

.mujo-review__body {
  font-size: 14px;
  line-height: 1.5;
  margin: 0 0 10px;
}

.mujo-review__photo img {
  border-radius: 12px;
  margin-top: 8px;
}
{% endstylesheet %}