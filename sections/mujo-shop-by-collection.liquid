{%- comment -%}
  MUJŌ CO. — Shop by Collection (editorial lookbook)
  Manually add up to 7 collections via blocks. Deliberately NOT a
  product grid: an automatic, alternating collage rhythm (wide /
  narrow / full-width tiles, cycling every 3 blocks) gives the mixed
  portrait/landscape, asymmetrical feel of a fashion lookbook without
  requiring the merchant to hand-size every tile.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital@1&family=Urbanist:wght@400;500;600&display=swap');

  .mujo-collection-{{ section.id }} {
    background: #FAFAF7;
    padding: 56px 0;
  }

  .mujo-collection-{{ section.id }} .mujo-col-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 5vw;
  }

  .mujo-collection-{{ section.id }} .mujo-col-heading {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(26px, 2.6vw, 34px);
    color: #1B1A18;
    margin: 0 0 32px;
  }

  .mujo-collection-{{ section.id }} .mujo-col-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 22px 18px;
  }

  .mujo-collection-{{ section.id }} .mujo-col-tile {
    display: block;
    text-decoration: none;
    color: inherit;
    grid-column: span 6;
  }

  /* Editorial rhythm: wide + narrow pair, then a full-width statement tile, repeating */
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+1) {
    grid-column: span 7;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+1) .mujo-col-media {
    aspect-ratio: 4 / 3;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+2) {
    grid-column: span 5;
    align-self: end;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+2) .mujo-col-media {
    aspect-ratio: 3 / 4;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+3) {
    grid-column: span 12;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+3) .mujo-col-media {
    aspect-ratio: 21 / 9;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+4) {
    grid-column: span 5;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+4) .mujo-col-media {
    aspect-ratio: 3 / 4;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+5) {
    grid-column: span 7;
    align-self: end;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+5) .mujo-col-media {
    aspect-ratio: 4 / 3;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+6) {
    grid-column: span 12;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+6) .mujo-col-media {
    aspect-ratio: 21 / 9;
  }

  .mujo-collection-{{ section.id }} .mujo-col-media {
    position: relative;
    overflow: hidden;
    background-color: #E5E2D9;
    aspect-ratio: 4 / 3;
  }
  .mujo-collection-{{ section.id }} .mujo-col-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .mujo-collection-{{ section.id }} .mujo-col-tile:hover .mujo-col-media img {
    transform: scale(1.04);
  }

  .mujo-collection-{{ section.id }} .mujo-col-caption {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .mujo-collection-{{ section.id }} .mujo-col-name {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 20px;
    color: #1B1A18;
  }
  .mujo-collection-{{ section.id }} .mujo-col-link {
    font-family: 'Urbanist', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6B6862;
  }

  /* Mobile: a proper compact 2-up grid, not the desktop collage
     shrunk to one column — uniform, smaller portrait tiles with
     tighter, intentional spacing. */
  @media screen and (max-width: 749px) {
    .mujo-collection-{{ section.id }} {
      padding: 40px 0;
    }
    .mujo-collection-{{ section.id }} .mujo-col-inner {
      padding: 0 16px;
    }
    .mujo-collection-{{ section.id }} .mujo-col-heading {
      font-size: 24px;
      margin-bottom: 18px;
    }
    .mujo-collection-{{ section.id }} .mujo-col-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px 10px;
    }
    .mujo-collection-{{ section.id }} .mujo-col-tile,
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+1),
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+2),
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+3),
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+4),
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+5),
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+6) {
      grid-column: span 1;
      align-self: auto;
    }
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+1) .mujo-col-media,
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+2) .mujo-col-media,
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+3) .mujo-col-media,
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+4) .mujo-col-media,
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+5) .mujo-col-media,
    .mujo-collection-{{ section.id }} .mujo-col-tile:nth-child(6n+6) .mujo-col-media {
      aspect-ratio: 3 / 4;
    }
    .mujo-collection-{{ section.id }} .mujo-col-caption {
      margin-top: 8px;
      gap: 2px;
    }
    .mujo-collection-{{ section.id }} .mujo-col-name {
      font-size: 14px;
    }
    .mujo-collection-{{ section.id }} .mujo-col-link {
      font-size: 9px;
      letter-spacing: 0.06em;
    }
  }
{%- endstyle -%}

<div class="mujo-collection-{{ section.id }}">
  <div class="mujo-col-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="mujo-col-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mujo-col-grid">
        {%- for block in section.blocks -%}
          {%- assign collection = block.settings.collection -%}
          <a
            href="{{ collection.url | default: '#' }}"
            class="mujo-col-tile"
            {{ block.shopify_attributes }}
          >
            <div class="mujo-col-media">
              {%- if collection.featured_image -%}
                <img
                  src="{{ collection.featured_image | image_url: width: 1200 }}"
                  srcset="{{ collection.featured_image | image_url: width: 600 }} 600w, {{ collection.featured_image | image_url: width: 900 }} 900w, {{ collection.featured_image | image_url: width: 1200 }} 1200w"
                  sizes="(max-width: 749px) 46vw, 50vw"
                  loading="lazy"
                  alt="{{ collection.featured_image.alt | default: collection.title | escape }}"
                  width="1200"
                  height="1200"
                >
              {%- endif -%}
            </div>
            <div class="mujo-col-caption">
              <span class="mujo-col-name">{{ collection.title | default: 'Collection' }}</span>
              {%- if block.settings.shop_label != blank -%}
                <span class="mujo-col-link">{{ block.settings.shop_label }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop by Collection",
  "tag": "section",
  "class": "section mujo-shop-by-collection-section",
  "max_blocks": 7,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Collection"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "shop_label",
          "label": "Small link text",
          "default": "Shop Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Collection"
    }
  ]
}
{% endschema %}
