</footer-accordion-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterAccordion{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.accordionButtons = this.querySelectorAll('[data-accordion-toggle]');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.accordionButtons.forEach((button) => {
          button.addEventListener('click', () => {
            const targetId = button.getAttribute('data-accordion-toggle');
            const content = this.querySelector(`[data-accordion-content="${targetId}"]`);
            const icon = button.querySelector('.ai-footer-accordion-icon-{{ ai_gen_id }}');
            
            const isExpanded = button.getAttribute('aria-expanded') === 'true';
            
            button.setAttribute('aria-expanded', !isExpanded);
            content.classList.toggle('active');
            icon.classList.toggle('active');
          });
        });
      }
    }

    customElements.define('footer-accordion-{{ ai_gen_id }}', FooterAccordion{{ ai_gen_id }});
  })();
</script>

