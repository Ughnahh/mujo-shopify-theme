{% doc %}
  @prompt
    i want a template which i post my coming soon items. Pls surprise me you can add a countdown and notify me button
     Then i can add the following
    1. Title and description
    2. Item
     -Add image that can add custom image and hover image
    -i can also edit the padding side to side, image must be like a cardboard style so that i can add 2 or more items that will be coming soon
    -card layout size can be edit and also the padding left and right can be edited
    3. -Upload video thats automatically play when visiting the page. It can be a sneaked pick
    4. I can edit all the color of font, size and everything, where is the video background video?

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
.ai-coming-soon-{{ ai_gen_id }} {
  /* use your adjustable paddings instead of hard-coded 0 / 40px */
  padding: {{ block.settings.section_padding_top }}px
           {{ block.settings.section_padding_horizontal }}px
           {{ block.settings.section_padding_bottom }}px;

  background-color: {{ block.settings.background_color }};
  background: {{ block.settings.background_gradient }};

  /* let the section size itself normally */
  min-height: auto;

  display: flex;
  flex-direction: column;
  align-items: center;

  /* content starts from the top, no vertical centering */
  justify-content: flex-start;

  text-align: center;
  position: relative;
  overflow: hidden;
}

  .ai-coming-soon-video-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    transform: translate(-50%, -50%);
    object-fit: cover;
    z-index: 1;
    opacity: {{ block.settings.video_opacity | divided_by: 100.0 }};
  }

  .ai-coming-soon-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: 1200px;
    width: 100%;
  }

  .ai-coming-soon-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_margin_bottom }}px;
  }

  .ai-coming-soon-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    font-weight: {{ block.settings.title_font_weight }};
    line-height: 1.2;
  }

  .ai-coming-soon-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0 0 {{ block.settings.description_margin_bottom }}px;
    line-height: 1.6;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-coming-soon-countdown-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: {{ block.settings.countdown_gap }}px;
    margin-bottom: {{ block.settings.countdown_margin_bottom }}px;
    flex-wrap: wrap;
  }

  .ai-coming-soon-countdown-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.countdown_bg_color }};
    border-radius: {{ block.settings.countdown_border_radius }}px;
    padding: {{ block.settings.countdown_padding }}px;
    min-width: {{ block.settings.countdown_min_width }}px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  }

  .ai-coming-soon-countdown-number-{{ ai_gen_id }} {
    font-size: {{ block.settings.countdown_number_size }}px;
    font-weight: {{ block.settings.countdown_number_weight }};
    color: {{ block.settings.countdown_number_color }};
    display: block;
    line-height: 1;
  }

  .ai-coming-soon-countdown-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.countdown_label_size }}px;
    color: {{ block.settings.countdown_label_color }};
    margin-top: 5px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-coming-soon-notify-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.notify_margin_bottom }}px;
  }

  .ai-coming-soon-notify-form-{{ ai_gen_id }} {
    display: flex;
    gap: 10px;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    max-width: 400px;
    margin: 0 auto;
  }

  .ai-coming-soon-notify-input-{{ ai_gen_id }} {
    flex: 1;
    min-width: 250px;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.input_text_color }};
    font-size: {{ block.settings.input_font_size }}px;
  }

  .ai-coming-soon-notify-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 1.5 }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-coming-soon-notify-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  .ai-coming-soon-items-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax({{ block.settings.card_min_width }}px, 1fr));
    gap: {{ block.settings.cards_gap }}px;
    padding: 0 {{ block.settings.cards_padding_horizontal }}px;
    max-width: 100%;
  }

.ai-coming-soon-item-{{ ai_gen_id }} {
  background-color: {{ block.settings.card_bg_color }};
  border-radius: {{ block.settings.card_border_radius }}px;
  padding: {{ block.settings.card_padding }}px;

  /* Center and cap width like mobile */
  max-width: 480px;
  margin: 0 auto {{ block.settings.cards_gap }}px;

  box-shadow: 0 {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  position: relative;
  overflow: hidden;
}

  .ai-coming-soon-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_shadow_y | times: 2 }}px {{ block.settings.card_shadow_blur | times: 2 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 50.0 }});
  }

.ai-coming-soon-item-image-{{ ai_gen_id }} {
  position: relative;
  width: 100%;
  max-width: 400px; /* adjust if you want wider/narrower */
  margin: 0 auto {{ block.settings.card_image_margin_bottom }}px;

  /* let height follow the image, no fixed height */
  border-radius: {{ block.settings.card_image_border_radius }}px;
  overflow: hidden;
}

  .ai-coming-soon-item-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease;
  }

  .ai-coming-soon-item-image-hover-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-coming-soon-item-{{ ai_gen_id }}:hover .ai-coming-soon-item-image-hover-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-coming-soon-item-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.card_image_border_radius }}px;
  }

  .ai-coming-soon-item-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-coming-soon-item-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_font_size }}px;
    color: {{ block.settings.card_title_color }};
    font-weight: {{ block.settings.card_title_font_weight }};
    margin: 0 0 {{ block.settings.card_title_margin_bottom }}px;
    line-height: 1.3;
  }

  .ai-coming-soon-item-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_description_font_size }}px;
    color: {{ block.settings.card_description_color }};
    line-height: 1.5;
    margin: 0;
  }

  .ai-coming-soon-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
    margin-top: 10px;
    font-size: {{ block.settings.message_font_size }}px;
  }

  .ai-coming-soon-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
    margin-top: 10px;
    font-size: {{ block.settings.message_font_size }}px;
  }

  @media screen and (max-width: 768px) {
    .ai-coming-soon-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-coming-soon-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.8 }}px;
    }

    .ai-coming-soon-countdown-{{ ai_gen_id }} {
      gap: {{ block.settings.countdown_gap | times: 0.7 }}px;
    }

    .ai-coming-soon-countdown-item-{{ ai_gen_id }} {
      min-width: {{ block.settings.countdown_min_width | times: 0.8 }}px;
      padding: {{ block.settings.countdown_padding | times: 0.8 }}px;
    }

    .ai-coming-soon-countdown-number-{{ ai_gen_id }} {
      font-size: {{ block.settings.countdown_number_size | times: 0.8 }}px;
    }

    .ai-coming-soon-notify-input-{{ ai_gen_id }} {
      min-width: 200px;
    }

    .ai-coming-soon-items-{{ ai_gen_id }} {
      grid-template-columns: repeat(auto-fit, minmax({{ block.settings.card_min_width | times: 0.8 }}px, 1fr));
      padding: 0 {{ block.settings.cards_padding_horizontal | times: 0.7 }}px;
    }
  }
{% endstyle %}

<coming-soon-{{ ai_gen_id }} class="ai-coming-soon-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_video_url != blank %}
    <video
      class="ai-coming-soon-video-{{ ai_gen_id }}"
      autoplay
      muted
      loop
      playsinline
    >
      <source src="{{ block.settings.background_video_url }}" type="video/mp4">
    </video>
  {% endif %}

  <div class="ai-coming-soon-content-{{ ai_gen_id }}">
    <div class="ai-coming-soon-header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h1 class="ai-coming-soon-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-coming-soon-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>

    {% if block.settings.enable_countdown %}
      <div class="ai-coming-soon-countdown-{{ ai_gen_id }}" data-countdown-date="{{ block.settings.countdown_date }}">
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <span class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-days>00</span>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Days</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <span class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-hours>00</span>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Hours</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <span class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-minutes>00</span>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Minutes</div>
        </div>
        <div class="ai-coming-soon-countdown-item-{{ ai_gen_id }}">
          <span class="ai-coming-soon-countdown-number-{{ ai_gen_id }}" data-seconds>00</span>
          <div class="ai-coming-soon-countdown-label-{{ ai_gen_id }}">Seconds</div>
        </div>
      </div>
    {% endif %}

    {% if block.settings.enable_notify %}
      <div class="ai-coming-soon-notify-{{ ai_gen_id }}">
        {% form 'contact' %}
          <input type="hidden" name="contact[tags]" value="coming-soon-notification">
          <div class="ai-coming-soon-notify-form-{{ ai_gen_id }}">
            <input
              type="email"
              name="contact[email]"
              class="ai-coming-soon-notify-input-{{ ai_gen_id }}"
              placeholder="{{ block.settings.email_placeholder }}"
              value="{{ form.email }}"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="ai-coming-soon-error-{{ ai_gen_id }}"
              {% endif %}
              {% if form.posted_successfully? %}
                aria-describedby="ai-coming-soon-success-{{ ai_gen_id }}"
              {% endif %}
            >
            <button type="submit" class="ai-coming-soon-notify-button-{{ ai_gen_id }}">
              {{ block.settings.notify_button_text }}
            </button>
          </div>
          {% if form.errors %}
            <div id="ai-coming-soon-error-{{ ai_gen_id }}" class="ai-coming-soon-error-{{ ai_gen_id }}">
              {{ form.errors.messages.email }}
            </div>
          {% endif %}
          {% if form.posted_successfully? %}
            <div id="ai-coming-soon-success-{{ ai_gen_id }}" class="ai-coming-soon-success-{{ ai_gen_id }}">
              {{ block.settings.success_message }}
            </div>
          {% endif %}
        {% endform %}
      </div>
    {% endif %}

    {% if block.settings.item_1_enabled or block.settings.item_2_enabled or block.settings.item_3_enabled or block.settings.item_4_enabled %}
      <div class="ai-coming-soon-items-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign item_enabled_key = 'item_' | append: i | append: '_enabled'
            assign item_image_key = 'item_' | append: i | append: '_image'
            assign item_hover_image_key = 'item_' | append: i | append: '_hover_image'
            assign item_title_key = 'item_' | append: i | append: '_title'
            assign item_description_key = 'item_' | append: i | append: '_description'

            assign item_enabled = block.settings[item_enabled_key]
            assign item_image = block.settings[item_image_key]
            assign item_hover_image = block.settings[item_hover_image_key]
            assign item_title = block.settings[item_title_key]
            assign item_description = block.settings[item_description_key]
          %}

          {% if item_enabled %}
            <div class="ai-coming-soon-item-{{ ai_gen_id }}">
              <div class="ai-coming-soon-item-image-{{ ai_gen_id }}">
                {% if item_image %}
                  <img
                    src="{{ item_image | image_url: width: 500 }}"
                    alt="{{ item_image.alt | escape }}"
                    loading="lazy"
                    width="{{ item_image.width }}"
                    height="{{ item_image.height }}"
                  >
                {% else %}
                  <div class="ai-coming-soon-item-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if item_hover_image %}
                  <img
                    src="{{ item_hover_image | image_url: width: 500 }}"
                    alt="{{ item_hover_image.alt | escape }}"
                    loading="lazy"
                    width="{{ item_hover_image.width }}"
                    height="{{ item_hover_image.height }}"
                    class="ai-coming-soon-item-image-hover-{{ ai_gen_id }}"
                  >
                {% endif %}
              </div>

              {% if item_title != blank %}
                <h3 class="ai-coming-soon-item-title-{{ ai_gen_id }}">{{ item_title }}</h3>
              {% endif %}

              {% if item_description != blank %}
                <div class="ai-coming-soon-item-description-{{ ai_gen_id }}">{{ item_description }}</div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</coming-soon-{{ ai_gen_id }}>

<script>
  (function() {
    class ComingSoon{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.countdownInterval = null;
      }

      connectedCallback() {
        this.initCountdown();
      }

      disconnectedCallback() {
        if (this.countdownInterval) {
          clearInterval(this.countdownInterval);
        }
      }

      initCountdown() {
        const countdownElement = this.querySelector('.ai-coming-soon-countdown-{{ ai_gen_id }}');
        if (!countdownElement) return;

        const countdownDate = countdownElement.dataset.countdownDate;
        if (!countdownDate) return;

        const targetDate = new Date(countdownDate).getTime();
        
        const updateCountdown = () => {
          const now = new Date().getTime();
          const distance = targetDate - now;

          if (distance < 0) {
            if (this.countdownInterval) {
              clearInterval(this.countdownInterval);
            }
            this.querySelector('[data-days]').textContent = '00';
            this.querySelector('[data-hours]').textContent = '00';
            this.querySelector('[data-minutes]').textContent = '00';
            this.querySelector('[data-seconds]').textContent = '00';
            return;
          }

          const days = Math.floor(distance / (1000 * 60 * 60 * 24));
          const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((distance % (1000 * 60)) / 1000);

          this.querySelector('[data-days]').textContent = days.toString().padStart(2, '0');
          this.querySelector('[data-hours]').textContent = hours.toString().padStart(2, '0');
          this.querySelector('[data-minutes]').textContent = minutes.toString().padStart(2, '0');
          this.querySelector('[data-seconds]').textContent = seconds.toString().padStart(2, '0');
        };

        updateCountdown();
        this.countdownInterval = setInterval(updateCountdown, 1000);
      }
    }

    customElements.define('coming-soon-{{ ai_gen_id }}', ComingSoon{{ ai_gen_id }});
  })();
</script>

