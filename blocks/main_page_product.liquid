{% doc %}
  @prompt
    Products Blocks
    
    Features required:
    	1.	Tab navigation for categories (e.g., Necklaces, Rings, Bracelets).
    	•	Tabs must be centered horizontally (justify-content: center).
    	•	Use a minimal underline style for the active tab.
    	•	Active tab should also have highlight color
    	•	On mobile, tabs should scroll horizontally if needed.
    	2.	Inside each tab, I can manually select products to display  4 to 5
    	3.	Product cards:
    	•	First image by default → switch to second image on hover (if available).
    	•	Show product title + price in smaller font (title 14–16px, price 12–14px).
    	•	Border radius + shadow options, compact spacing.
    	4.	Grid layout:
    	•	2 columns on mobile, 4 on desktop.
    	•	Add left/right padding so products don’t touch the edges (~20px mobile, ~40px desktop).
    	5.	Hover logic:
    	•	Smooth fade animation.
    	•	If no second image, just stay on first.
    	6.	Shop All button:
    	•	A single button centered below the product grid (not per tab).
    	•	Links to all products (e.g., /collections/all).
    	•	Customizable label, colors, radius., it does not shoe the products when i select

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-products-block-{{ ai_gen_id }} {
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};}

  @media screen and (min-width: 750px) {
    .ai-products-block-{{ ai_gen_id }} {
      padding: 60px 40px;
    }
  }

  .ai-products-tabs-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    margin-bottom: 40px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .ai-products-tabs-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-products-tab-{{ ai_gen_id }} {
    position: relative;
    padding: 12px 24px;
    background: none;
    border: none;
    color: {{ block.settings.tab_text_color }};
    font-size: 16px;
    cursor: pointer;
    white-space: nowrap;
    transition: color 0.3s ease;
    border-bottom: 2px solid transparent;
  }

  .ai-products-tab-{{ ai_gen_id }}:hover {
    color: {{ block.settings.tab_active_color }};
  }

  .ai-products-tab-{{ ai_gen_id }}.active {
    color: {{ block.settings.tab_active_color }};
    border-bottom-color: {{ block.settings.tab_active_color }};
  }

  .ai-products-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    padding: 0 16px; /* ✅ Add left/right padding for mobile */
    box-sizing: border-box;
    margin-bottom: 40px;
  }

  @media screen and (min-width: 750px) {
    .ai-products-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      padding: 0 40px; /* ✅ More padding on desktop */
    }
  }

  .ai-product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    color: inherit;
  }

  .ai-product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-2px);
    box-shadow: {{ block.settings.card_shadow_horizontal }}px {{ block.settings.card_shadow_vertical | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | times: 1.5 }});
  }

  .ai-product-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .ai-product-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;transition: opacity 0.3s ease;
  }

  .ai-product-image-{{ ai_gen_id }}.secondary {
    opacity: 0;}

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-{{ ai_gen_id }}.secondary {
    opacity: 1;
  }

  .ai-product-card-{{ ai_gen_id }}:hover .ai-product-image-{{ ai_gen_id }}.primary {
    opacity: 0;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-image-placeholder-{{ ai_gen_id }} svg {
    width: 80%;
    height: 80%;opacity: 0.3;
  }

  .ai-product-info-{{ ai_gen_id }} {
    padding: 12px;
  }

  .ai-product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 4px;
    line-height: 1.3;
    font-family: 'Figtree', sans-serif;
  }

  .ai-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    margin: 0;
    font-family: 'Figtree', sans-serif;
  }

  .ai-tab-content-{{ ai_gen_id }} {
    display: none;
  }

  .ai-tab-content-{{ ai_gen_id }}.active {
    display: block;
  }

  .ai-shop-all-button-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
  }

  .ai-shop-all-link-{{ ai_gen_id }} {
    display: inline-block;
    background: none;
    border: none;
    padding: 0;
    font-size: 16px;
    font-weight: 500;
    color:  #000000; /* black */
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
    transition: color 0.3s ease;
  }

.ai-shop-all-link-{{ ai_gen_id }}:hover {
  color: {{ block.settings.button_hover_color }};
}

  .ai-shop-all-link-{{ ai_gen_id }}:hover {
  background-color: #ffffff !important;
  color: #CDA9E6 !important;
  text-decoration: underline;
  }

  .ai-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-style: italic;
  }
{% endstyle %}

<product-tabs-{{ ai_gen_id }}
  class="ai-products-block-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-products-tabs-{{ ai_gen_id }}">
  {% if block.settings.tab_section_heading != blank %}
  <h2 class="ai-products-heading-{{ ai_gen_id }}">
    {{ block.settings.tab_section_heading }}
  </h2>
{% endif %}
    {% for i in (1..4) %}
      {% liquid
        assign tab_name_key = 'tab_' | append: i | append: '_name'
        assign tab_name = block.settings[tab_name_key]
      %}
      {% if tab_name != blank %}
        <button
          class="ai-products-tab-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
          data-tab="{{ i }}"
        >
          {{ tab_name }}
        </button>
      {% endif %}
    {% endfor %}
  </div>

    {% assign tab_names = 
      block.settings.tab_1_name | append: '||' |
      append: block.settings.tab_2_name | append: '||' |
      append: block.settings.tab_3_name | split: '||' 
    %}

{% for i in (1..4) %}
  {% capture tab_key %}tab_{{ i }}_name{% endcapture %}
  {% assign tab_name = block.settings[tab_key] %}

  {% capture products_key %}tab_{{ i }}_products{% endcapture %}
  {% assign products = block.settings[products_key] %}

  {% if tab_name != blank %}
    <div
      class="ai-tab-content-{{ ai_gen_id }} {% if forloop.first %}active{% endif %}"
      data-tab-content="{{ i }}"
    >
      {% if products and products != empty %}
        <div class="ai-products-grid-{{ ai_gen_id }}">
          {% for product in products %}
            {% if product != blank %}
              <a href="{{ product.url }}" class="ai-product-card-{{ ai_gen_id }}">
                <div class="ai-product-image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      class="ai-product-image-{{ ai_gen_id }} primary"
                      loading="lazy"
                      width="400"
                      height="400"
                    >
                    {% if product.images[1] %}
                      <img
                        src="{{ product.images[1] | image_url: width: 400 }}"
                        alt="{{ product.images[1].alt | escape }}"
                        class="ai-product-image-{{ ai_gen_id }} secondary"
                        loading="lazy"
                        width="400"
                        height="400"
                      >
                    {% endif %}
                  {% else %}
                    <div class="ai-product-image-placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>
                <div class="ai-product-info-{{ ai_gen_id }}">
                  <h3 class="ai-product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <p class="ai-product-price-{{ ai_gen_id }}">{{ product.price | money }}</p>
                </div>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        <div class="ai-empty-state-{{ ai_gen_id }}">
          Select products for the "{{ tab_name }}" tab
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endfor %}

  {% if block.settings.show_shop_all_button %}
    <div class="ai-shop-all-button-{{ ai_gen_id }}">
      <a href="{{ block.settings.shop_all_link }}" class="ai-shop-all-link-{{ ai_gen_id }}">
        {{ block.settings.shop_all_text }}
      </a>
    </div>
  {% endif %}
</product-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.tabs = this.querySelectorAll('.ai-products-tab-{{ ai_gen_id }}');
        this.tabContents = this.querySelectorAll('.ai-tab-content-{{ ai_gen_id }}');
        
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            const tabNumber = tab.dataset.tab;
            this.switchTab(tabNumber);
          });
        });
      }

      switchTab(activeTabNumber) {
        this.tabs.forEach(tab => {
          tab.classList.remove('active');if (tab.dataset.tab === activeTabNumber) {
            tab.classList.add('active');
          }
        });

        this.tabContents.forEach(content => {
          content.classList.remove('active');
          if (content.dataset.tabContent === activeTabNumber) {
            content.classList.add('active');
          }
        });
      }
    }

    customElements.define('product-tabs-{{ ai_gen_id }}', ProductTabs{{ ai_gen_id }});
  })();
</script>

