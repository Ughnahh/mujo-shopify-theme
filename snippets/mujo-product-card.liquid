{%- doc -%}
  MUJŌ CO. — unified editorial product card. Image + title/details/
  price/swatches form one continuous card, no gap or border between
  the image and the info block below it.

  Desktop hover: the image crossfades to the product's secondary
  photo (product.media[1]) and an "Add to Bag" button reveals inline
  between the price and the color swatches. Touch devices show the
  button permanently, since hover doesn't exist there.

  Clicking a color swatch swaps the card's base image to that
  variant's photo, updates the price, and shows a selection ring —
  independent of the hover secondary-image effect.

  @param {product} product - Product Liquid object
  @param {string} [section_id] - id of the containing section
  @param {boolean} [lazy_load] - lazy-load the card image (default: true)
  @param {boolean} [show_badge] - show a small badge over the image (default: false)
  @param {string} [badge_text] - badge label, e.g. "Bestseller"

  @example
  {% render 'mujo-product-card', product: product, section_id: section.id, lazy_load: true, show_badge: true, badge_text: 'Bestseller' %}
{%- enddoc -%}

{%- liquid
  assign lazy_load = lazy_load | default: true
  assign default_variant = product.selected_or_first_available_variant
  assign default_image = default_variant.featured_image | default: product.featured_image
  assign secondary_image = product.media[1]

  assign color_position = 0
  for option in product.options_with_values
    if option.name == 'Color' or option.name == 'Colour'
      assign color_position = option.position
    endif
  endfor
  assign color_index = color_position | minus: 1
  assign form_id = 'mujo-pc-form-' | append: section_id | append: product.id
-%}

<mujo-product-card class="mujo-pc">
  <div class="mujo-pc-media">
    {%- if show_badge and badge_text != blank -%}
      <span class="mujo-pc-badge">{{ badge_text }}</span>
    {%- endif -%}
    <a href="{{ product.url }}" class="mujo-pc-media-link" aria-label="{{ product.title | escape }}">
      {%- if default_image -%}
        <img
          class="mujo-pc-image mujo-pc-image-primary"
          src="{{ default_image | image_url: width: 700 }}"
          srcset="{{ default_image | image_url: width: 400 }} 400w, {{ default_image | image_url: width: 700 }} 700w, {{ default_image | image_url: width: 1000 }} 1000w"
          sizes="(max-width: 749px) 60vw, 320px"
          alt="{{ default_image.alt | default: product.title | escape }}"
          width="{{ default_image.width }}"
          height="{{ default_image.height }}"
          {%- unless lazy_load == false %}
            loading="lazy"
          {%- endunless %}
        >
      {%- endif -%}
      {%- if secondary_image -%}
        <img
          class="mujo-pc-image mujo-pc-image-secondary"
          src="{{ secondary_image | image_url: width: 700 }}"
          srcset="{{ secondary_image | image_url: width: 400 }} 400w, {{ secondary_image | image_url: width: 700 }} 700w, {{ secondary_image | image_url: width: 1000 }} 1000w"
          sizes="(max-width: 749px) 60vw, 320px"
          alt=""
          aria-hidden="true"
          loading="lazy"
        >
      {%- endif -%}
    </a>
  </div>

  <div class="mujo-pc-info">
    <a href="{{ product.url }}" class="mujo-pc-title">{{ product.title | escape }}</a>
    {%- if product.type != blank -%}
      <div class="mujo-pc-subtitle">{{ product.type }}</div>
    {%- endif -%}
    <div class="mujo-pc-price">
      {%- if default_variant.compare_at_price > default_variant.price -%}
        <span class="mujo-pc-price-sale">{{ default_variant.price | money }}</span>
        <s class="mujo-pc-price-compare">{{ default_variant.compare_at_price | money }}</s>
      {%- else -%}
        <span class="mujo-pc-price-regular">{{ default_variant.price | money }}</span>
      {%- endif -%}
    </div>

    {%- if default_variant -%}
      <product-form class="mujo-pc-add-to-bag-wrap" data-section-id="{{ section_id }}">
        {%- form 'product',
          product,
          id: form_id,
          class: 'mujo-pc-form',
          novalidate: 'novalidate',
          data-type: 'add-to-cart-form'
        -%}
          <input
            type="hidden"
            name="id"
            class="mujo-pc-variant-id product-variant-id"
            value="{{ default_variant.id }}"
            {%- unless default_variant.available %}
              disabled
            {%- endunless %}
          >
          <button
            type="submit"
            name="add"
            class="mujo-pc-add-to-bag"
            aria-label="{{ 'products.product.add_to_cart' | t }} — {{ product.title | escape }}"
            {%- unless default_variant.available %}
              disabled
            {%- endunless %}
          >
            <span class="mujo-pc-add-to-bag-label">
              {%- if default_variant.available -%}
                Add to Bag
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
            <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
            {%- render 'loading-spinner' -%}
          </button>
        {%- endform -%}
      </product-form>
    {%- endif -%}

    {%- if color_position > 0 -%}
      {%- assign seen_colors = '|' -%}
      <div class="mujo-pc-swatches" role="group" aria-label="Color">
        {%- for variant in product.variants -%}
          {%- assign color_value = variant.options[color_index] -%}
          {%- assign color_marker = '|' | append: color_value | append: '|' -%}
          {%- unless seen_colors contains color_marker -%}
            {%- assign seen_colors = seen_colors | append: color_value | append: '|' -%}
            {%- assign swatch_image = variant.featured_image | default: default_image -%}
            <button
              type="button"
              class="mujo-pc-swatch{% if variant.id == default_variant.id %} is-selected{% endif %}"
              style="background-color: {{ color_value | handleize }};"
              aria-label="{{ color_value | escape }}"
              aria-pressed="{% if variant.id == default_variant.id %}true{% else %}false{% endif %}"
              data-variant-id="{{ variant.id }}"
              data-available="{{ variant.available }}"
              data-image="{{ swatch_image | image_url: width: 700 }}"
              data-image-srcset="{{ swatch_image | image_url: width: 400 }} 400w, {{ swatch_image | image_url: width: 700 }} 700w, {{ swatch_image | image_url: width: 1000 }} 1000w"
              data-price="{{ variant.price | money }}"
              data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
            ></button>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</mujo-product-card>
